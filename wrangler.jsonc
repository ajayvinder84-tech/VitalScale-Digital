{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vitalscale-digital-rebuild",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "vitalscaledigital.com.au",
      "custom_domain": true
    },
    {
      "pattern": "www.vitalscaledigital.com.au",
      "custom_domain": true
    }
  ]
}
